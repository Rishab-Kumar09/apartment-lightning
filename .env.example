# Anthropic API key — used to parse natural-language search requests into
# structured criteria (preferences/parser.ts). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Solari API key — get one free for a month at getsolari.com with promo code
# STARTER1MO-MKY4BNDK. Leave blank to run entirely against the mock adapter
# (a real local Playwright browser against the seed fixture site — see
# src/solari/mockClient.ts). Setting this alone is enough to switch to the
# real Solari cloud browser; no code changes needed.
SOLARI_API_KEY=

# Force mock mode even if SOLARI_API_KEY is set (useful for fast iteration
# without spending cloud browser minutes). "1" or "true" to force mock.
MOCK_SOLARI=

PORT=3000
DB_PATH=./data/app.db
