{
  "name": "apartment-lightning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The agent that never misses a new apartment listing. Human-in-the-loop apartment hunting on Solari.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/cli/run.ts",
    "seed": "tsx --env-file=.env src/cli/run.ts --seed",
    "seed:applicant": "tsx --env-file=.env scripts/seed-applicant.ts",
    "demo:reset": "tsx --env-file=.env scripts/demo-seed.ts --reset",
    "watch:live": "tsx --env-file=.env scripts/watch-live.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@solarisdk/browser": "^0.1.2",
    "express": "^4.21.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
